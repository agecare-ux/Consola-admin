# Copia a .env y ajusta
# Conéctate con el rol de la API (creado con aplicar_modelo --rol-api), no con el
# propietario de las tablas: el propietario se salta la seguridad por fila.
ADMIN_DATABASE_URL=postgresql+asyncpg://agecare_api:CLAVE@localhost:5432/agecare_admin
ADMIN_JWT_SECRET=cambia-esto-en-produccion
ADMIN_ENVIRONMENT=dev
ADMIN_ALLOWED_EMAIL_DOMAINS=wellq.co.uk,wellq.co
# Tenant fijo mientras se decide cómo resolverlo en el login (modelo, punto 9.1)
ADMIN_TENANT_ID=00000000-0000-0000-0000-000000000001

# Cuentas demo: contraseñas y secreto TOTP de los administradores. No se versionan.
# Genera valores con: python -m scripts.credenciales_demo --generar
DEMO_CLAVE_ADMIN=
DEMO_CLAVE_SOPORTE=
DEMO_CLAVE_ANALISTA=
DEMO_CLAVE_EDITORA=
DEMO_CLAVE_MODERADOR=
DEMO_MFA_SECRET=
